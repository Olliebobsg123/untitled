{
  "name": "lighting-console",
  "version": "1.0.0",
  "productName": "Lighting Console",
  "description": "Custom Lighting Control Console",
  "author": "Oliver Grainger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:syntax": "node --check main.js && node --check startup.js && node --check relay.js && node --check usb-dmx.js && for f in js/*.js js/fixtures/*.js; do node --check \"$f\" || exit 1; done",
    "build-mac": "rm -rf Build && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --mac --publish never",
    "build-win": "npx electron-builder --win --publish never"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.olivergrainger.lightingconsole",
    "productName": "Lighting Console",
    "directories": {"output": "Build"},
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "config/entitlements.mac.plist",
      "entitlementsInherit": "config/entitlements.mac.plist",
      "extendInfo": {"NSLocalNetworkUsageDescription": "Lighting Console needs local network access to communicate with lighting equipment and QLab."}
    },
    "win": {
      "target": [
        {"target": "nsis", "arch": ["x64"]},
        {"target": "portable", "arch": ["x64"]}
      ],
      "artifactName": "Lighting-Console-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighting Console"
    }
  }
}
