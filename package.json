{
  "name": "lighting-console",
  "version": "1.0.0",
  "productName": "Lighting Console",
  "description": "Custom Lighting Control Console",
  "author": "Oliver Grainger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:syntax": "node scripts/check-syntax.js",
    "build-mac": "rm -rf Build && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --mac --publish never",
    "build-win": "npx electron-builder --win --publish never",
    "test": "npm run test:syntax && node tests/visualizer-decode.test.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "iobroker.tapo": "^0.6.12",
    "serialport": "^12.0.0",
    "three": "0.160.0",
    "tp-link-tapo-connect": "^2.0.15",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.olivergrainger.lightingconsole",
    "productName": "Lighting Console",
    "directories": {
      "output": "Build",
      "buildResources": "assets"
    },
    "asar": true,
    "afterPack": "scripts/after-pack-mac.js",
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "config/entitlements.mac.plist",
      "entitlementsInherit": "config/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Lighting Console needs local network access to communicate with lighting equipment and QLab.",
        "NSMicrophoneUsageDescription": "Light Spark listens to a sound input for audio timecode (LTC) when you turn it on."
      },
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lighting-Console-${version}-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighting Console"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!remote-ios/**",
      "!Build/**",
      "!assets/**",
      "!show-mode-launcher.command",
      "!repomix-output.xml",
      "!**/*.md"
    ],
    "portable": {
      "artifactName": "Lighting-Console-${version}-portable.${ext}"
    }
  }
}
