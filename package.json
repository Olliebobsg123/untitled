{
  "name": "lighting-console",
  "version": "1.0.0",
  "productName": "Lighting Console",
  "description": "Light Spark: lighting control console",
  "author": "Oliver Grainger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:syntax": "node scripts/check.js",
    "build-mac": "rm -rf Build && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --mac --publish never",
    "build-win": "npx electron-builder --win --publish never",
    "format": "prettier --write \"js/**/*.js\" \"main/**/*.js\" main.js preload.js",
    "test": "npm run test:syntax && node tests/visualizer-decode.test.mjs && node tests/license.test.cjs"
  },
  "dependencies": {
    "iobroker.tapo": "^0.6.12",
    "serialport": "^12.0.0",
    "three": "^0.160.0",
    "tp-link-tapo-connect": "^2.0.15",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.3.3"
  },
  "build": {
    "appId": "com.olivergrainger.lightingconsole",
    "productName": "Lighting Console",
    "directories": {
      "output": "Build"
    },
    "asar": true,
    "afterPack": "scripts/after-pack-mac.js",
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "config/entitlements.mac.plist",
      "entitlementsInherit": "config/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Lighting Console needs local network access to communicate with lighting equipment and QLab."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lighting-Console-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighting Console"
    }
  }
}
